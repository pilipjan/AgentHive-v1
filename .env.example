# ==========================================
# AgentHive V1 — Environment Configuration
# NOTE: Use dummy placeholders. Never commit real API keys!
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=AgentHive
APP_VERSION=1.0.0
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api/v1
SECRET_KEY=dummy-development-secret-key-change-in-production-min-32-chars

# Database Configuration (Dedicated AgentHive PostgreSQL Instance)
POSTGRES_USER=agenthive
POSTGRES_PASSWORD=agenthive_dev_password_only
POSTGRES_DB=agenthive
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://agenthive:agenthive_dev_password_only@127.0.0.1:5433/agenthive

# Model Providers (Optional / Fallback)
# AgentHive operates with local Ollama or Mock provider by default.
OPENAI_API_KEY=sk-dummy-openai-key-for-development-only
ANTHROPIC_API_KEY=sk-ant-dummy-anthropic-key
GEMINI_API_KEY=AIzaSyDummyGeminiKeyForDevOnly
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Security & Guardrails
MAX_TASK_RECURSION_DEPTH=5
MAX_AGENT_MESSAGE_CHAIN=10
TASK_TIMEOUT_SECONDS=120
MEMORY_FIREWALL_STRICT_MODE=true
ENABLE_SIMULATED_TOOLS=true

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3001
